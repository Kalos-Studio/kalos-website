# Copy to .env.local for local dev (gitignored). Set real values in Netlify's
# env vars for production — don't commit secrets.

# Canonical origin, used to build absolute URLs for metadata and OG images.
# Optional: app/layout.js falls back to Netlify's own URL / DEPLOY_PRIME_URL,
# and only needs this when you want a preview to advertise the production
# origin, or when running outside Netlify.
# NEXT_PUBLIC_SITE_URL=https://kalos.studio

# WORK_PASSWORD and WORK_ACCESS_TOKEN used to live here, for the password gate
# in front of /work. That gate is gone: the homepage links to the work, so the
# section is public. If either is still set in Netlify, it is now inert and can
# be deleted there too.
