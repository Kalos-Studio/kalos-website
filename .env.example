# Copy to .env.local for local dev (gitignored). Set the real values in
# Netlify's env vars for production -- do not commit real ones.

# The password over every case study's body. See lib/work-lock.js: this is a
# soft gate buying time while the write-ups are cleaned up, not a security
# boundary, and it defaults to "kalos" when unset.
#
# Changing it invalidates every cookie already handed out, because the cookie
# holds a digest of this value rather than a token of its own.
WORK_PASSWORD=kalos

# Set to "off" to open every case study without reverting the gate.
WORK_LOCK=on
