# Copy to .env.local for local dev (gitignored). Set the real values in
# Netlify's env vars for production — don't commit real secrets.

# Password for the gate in front of /work. Defaults to "k4l0s" if unset.
WORK_PASSWORD=k4l0s

# Value stored in the auth cookie once someone enters the password above.
# Defaults to "granted-kalos-work" if unset. Change it (and/or WORK_PASSWORD)
# to invalidate everyone's existing session, e.g. after sharing the password
# more widely than intended.
WORK_ACCESS_TOKEN=granted-kalos-work
